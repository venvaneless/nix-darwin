// macOS Gruvbox Fastfetch profile

{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/dev/doc/json_schema.json",
  "logo": {
    "source": "__FASTFETCH_ASCII__",
    "padding": {
      "top": 1,
      "left": 1,
    },
  },
  "display": {
    "separator": "",
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#fabd2f",
        "at": "white",
        "host": "#fabd2f",
      },
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;250;189;47m────────────────────────────────  SYSTEM ──────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[38;2;250;189;47m󰣇 OS\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "#fabd2f",
    },
    {
      "type": "host",
      "key": "\u001b[38;2;250;189;47m󰌢 Host\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "#fabd2f",
    },
    {
      "type": "kernel",
      "key": "\u001b[38;2;250;189;47m Kernel\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "#fabd2f",
    },
    {
      "type": "uptime",
      "key": "\u001b[38;2;250;189;47m󰅐 Uptime\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "#fabd2f",
    },
    {
      "type": "packages",
      "key": "\u001b[38;2;250;189;47m󰏖 Packages\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "#fabd2f",
    },
    {
    "type": "custom",
    "format": ""
    },

    
    {
      "type": "custom",
      "format": "\u001b[38;2;254;128;25m───────────────────────────────  HARDWARE ─────────────────────────────────\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;2;254;128;25m CPU\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;254;128;25",
      "showPeCoreCount": true,
      "temp": true,
    },
    {
      "type": "gpu",
      "key": "\u001b[38;2;254;128;25m󰢮 GPU\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;254;128;25",
    },
    {
      "type": "memory",
      "key": "\u001b[38;2;254;128;25m󰍛 RAM\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;254;128;25",
      "format": "{used} / {total}",
    },
    {
      "type": "swap",
      "key": "\u001b[38;2;254;128;25m󰓡 Swap\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;254;128;25",
    },
    {
      "type": "disk",
      "key": "\u001b[38;2;254;128;25m Disk\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;254;128;25",
    },
    {
      "type": "custom",
      "format": ""
    },


    {
      "type": "custom",
      "format": "\u001b[38;2;131;165;152m───────────────────────────────  TERMINAL / SHELL ──────────────────────────\u001b[0m"
    },
    {
      "type": "shell",
      "key": "\u001b[38;2;131;165;152m Shell\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;131;165;152",
    },
    {
      "type": "editor",
      "key": "\u001b[38;2;131;165;152m Editor\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;131;165;152",
    },
    {
      "type": "terminal",
      "key": "\u001b[38;2;131;165;152m Terminal\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;131;165;152",
    },
    {
      "type": "terminalfont",
      "key": "\u001b[38;2;131;165;152m Term Font\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;131;165;152",
    },
    {
      "type": "terminalsize",
      "key": "\u001b[38;2;131;165;152m Term Size\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;131;165;152",
    },
    {
      "type": "command",
      "key": "\u001b[38;2;131;165;152m Cwd\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;131;165;152",
      "text": "{1}",
      "shell": "/bin/sh",
      "param": "-c",
      "cmd": "pwd",
    },
    {
      "type": "custom",
      "format": ""
    },

    
    {
      "type": "custom",
      "format": "\u001b[38;2;184;187;38m────────────────────────────────  STATE ─────────────────────────────────────\u001b[0m"
    },
    {
      "type": "loadavg",
      "key": "\u001b[38;2;184;187;38m󰓅 Load Avg\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;184;187;38",
    },
    {
      "type": "processes",
      "key": "\u001b[38;2;184;187;38m Processes\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;184;187;38",
    },
    {
      "type": "datetime",
      "key": "\u001b[38;2;184;187;38m󰃰 Date\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;184;187;38",
    },
    {
      "type": "locale",
      "key": "\u001b[38;2;184;187;38m󰗊 Locale\u001b[38;2;235;219;178m : \u001b[0m",
      "outputColor": "38;2;184;187;38",
    },
    {
      "type": "custom",
      "format": ""
    },

    "break",
    "colors",
  ],
}
