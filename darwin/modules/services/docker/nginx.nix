# /Users/ven/.config/nix/nix-darwin/darwin/modules/services/docker/nginx.nix
#
# NGINX (DARWIN, CUSTOM)
# ============================================================
# - Installs nginx from Nixpkgs
# - Writes main nginx.conf to:
#       ~/ven-dots/conf/nginx.conf
# - Includes vhosts from:
#       ~/ven-dots/conf/apps-enabled/*.conf
# - Logs to:
#       ~/ven-dots/conf/logs/{access,error}.log
# - Provides run-nginx-custom wrapper + launchd daemon.
# - No Linux/systemd bits. Pure nix-darwin + launchd.
# ============================================================

{ config, pkgs, lib, ... }:

let
  userName = "ven";
  userHome = config.users.users.${userName}.home;

  confRoot   = "${userHome}/ven-dots/conf";
  nginxConf  = "${confRoot}/nginx.conf";
  appsDir    = "${confRoot}/apps-enabled";
  logsDir    = "${confRoot}/logs";

  nginxBin   = "${pkgs.nginx}/bin/nginx";

  nginxSetupScript = pkgs.writeShellScriptBin "nginx-setup" ''
    #!/usr/bin/env bash
    set -euo pipefail

    echo ">>> [nginx] Creating config + folders"
    echo ">>> [nginx]   conf:  ${confRoot}"
    echo ">>> [nginx]   apps:  ${appsDir}"
    echo ">>> [nginx]   logs:  ${logsDir}"

    mkdir -p "${confRoot}" "${appsDir}" "${logsDir}"
    touch "${logsDir}/access.log" "${logsDir}/error.log"

    echo ">>> [nginx] Writing nginx.conf → ${nginxConf}"
    cat > "${nginxConf}" <<EOF
# AUTO-GENERATED BY NIX - DO NOT EDIT BY HAND

worker_processes  1;

events {
  worker_connections 1024;
}

http {
  # Use nginx's mime.types from the Nix store
  include       ${pkgs.nginx}/conf/mime.types;
  default_type  application/octet-stream;

  log_format  main  '\$remote_addr - \$remote_user [\$time_local] "\$request" '
                    '\$status \$body_bytes_sent "\$http_referer" '
                    '"\$http_user_agent" "\$http_x_forwarded_for"';

  access_log  ${logsDir}/access.log  main;
  error_log   ${logsDir}/error.log;

  sendfile        on;
  keepalive_timeout  65;

  # Per-app configs (Vaultwarden, future stuff)
  include ${appsDir}/*.conf;
}
EOF
  '';

  runner = pkgs.writeShellScriptBin "run-nginx-custom" ''
    #!/usr/bin/env bash
    set -euo pipefail

    echo ">>> [nginx] Using config: ${nginxConf}"

    # Test config before starting
    "${nginxBin}" -t -c "${nginxConf}" || {
      echo "!!! [nginx] nginx -t failed for ${nginxConf}"
      exit 1
    }

    echo ">>> [nginx] Starting nginx (daemon off)"
    exec "${nginxBin}" -g "daemon off;" -c "${nginxConf}"
  '';
in
{
  # Tools: nginx, setup script, runner
  environment.systemPackages = [ pkgs.nginx nginxSetupScript runner ];

  # Run nginx-setup during activation (same pattern as cleanup)
  system.activationScripts.extraActivation.text = lib.mkAfter ''
    echo ">>> Running nginx-setup"
    ${nginxSetupScript}/bin/nginx-setup || echo "!!! nginx-setup failed (continuing)"
  '';

  # Launchd service (Darwin only)
  launchd.daemons.nginx-custom = {
    serviceConfig = {
      Label            = "com.ven.nginx-custom";
      ProgramArguments = [ "${runner}/bin/run-nginx-custom" ];
      RunAtLoad        = true;
      KeepAlive        = true;
      WorkingDirectory = "${confRoot}";
    };
  };
}
